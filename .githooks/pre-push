#!/usr/bin/env bash

set -eu

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

echo "Checking Rust formatting..."
cargo fmt --all -- --check

echo "Checking TOML formatting..."
taplo fmt --check

echo "Checking Python formatting..."
uv run ruff format --check .

echo "Linting Python..."
uv run ruff check .

echo "Checking GPS dashboard..."
(
    cd "$ROOT/gps-dashboard"
    cargo clippy --all-targets --locked -- -D warnings
    cargo test --locked
)

echo "Running Clippy for the Uno R4 HAL..."
cargo clippy -p arduino-uno-r4-hal \
    --target thumbv7em-none-eabihf \
    --lib \
    -- -D warnings
cargo clippy -p arduino-uno-r4-hal \
    --target thumbv7em-none-eabihf \
    --examples \
    -- -D warnings

echo "Running Clippy for morse-r4..."
cargo clippy -p morse-r4 \
    --target thumbv7em-none-eabihf \
    --bin morse \
    -- -D warnings

echo "Running Clippy for morse..."
(
    cd "$ROOT/morse"
    cargo clippy --bin morse -- -D warnings
)

echo "Checking temperature..."
cargo check -p temperature --target avr-none

echo "Running Clippy for temperature..."
cargo clippy -p temperature --target avr-none -- -D warnings

echo "Checking propeller..."
(
    cd "$ROOT/propeller"
    cargo clippy --all-targets -- -D warnings
    cargo build
)

echo "Building morse-r4..."
cargo build -p morse-r4 --target thumbv7em-none-eabihf

echo "Building morse..."
(
    cd "$ROOT/morse"
    cargo build
)

if [ -f "$HOME/export-esp.sh" ] && {
    [ -f "$ROOT/weather/.env" ] ||
        {
            [ -n "${SSID:-}" ] &&
                [ -n "${PASSWORD:-}" ] &&
                [ -n "${OPENWEATHER_API_KEY:-}" ] &&
                [ -n "${LATITUDE:-}" ] &&
                [ -n "${LONGITUDE:-}" ];
        }
}; then
    echo "Checking weather..."
    (
        cd "$ROOT/weather"
        # shellcheck disable=SC1091
        source "$HOME/export-esp.sh"
        cargo clippy --bin weather -- -D warnings
        cargo build --bin weather
    )
else
    echo "Skipping weather checks: ESP toolchain export and weather credentials are required."
fi

echo "Pre-push checks passed."
